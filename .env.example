# BharatCode Model API Configuration (Required on server)
# Get your API key from https://bharatcode.ai
BHARATCODE_API_KEY=your_bharatcode_api_key_here

# Optional overrides (defaults shown below)
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# Optional Rate Limit overrides (per IP window)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
